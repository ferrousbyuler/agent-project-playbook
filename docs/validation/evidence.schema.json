{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-project-playbook/evidence.schema.json",
  "title": "Validation evidence",
  "description": "A machine-readable record of one check or slice. No secrets.",
  "type": "object",
  "required": [
    "schema",
    "title",
    "when",
    "ok"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "agent-project-playbook-evidence/v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "when": {
      "type": "string",
      "description": "Local timestamp with timezone label"
    },
    "ok": {
      "type": "boolean"
    },
    "change": {
      "type": [
        "string",
        "null"
      ],
      "description": "OpenSpec change name or issue id, if any"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cmd",
          "exit_code"
        ],
        "additionalProperties": false,
        "properties": {
          "cmd": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "duration_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "Repo-relative or generic label, never a secret path"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "bytes": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "wrote_live_job_files": {
      "type": "boolean"
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
